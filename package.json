{
  "name": "titanfit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server.cjs",
    "start": "npm run build && npm run server",
    "test:server": "node --test tests/server.test.cjs",
    "test:e2e": "node tests/e2e.test.cjs",
    "test:demo": "node tests/demo.test.cjs",
    "backup": "node scripts/backup.cjs",
    "migrate:turso": "node scripts/migrate-to-turso.cjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
